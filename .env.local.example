# Local Next.js development. Docker Compose supplies its own values.
NEXT_PUBLIC_USE_MOCK_API=false
SSO_API_URL=http://localhost:8000/api/v1
SSO_PORTAL_ORIGIN=http://localhost:3000
# Enable only behind the configured trusted ingress.
SSO_TRUST_PROXY_HEADERS=false
# Migration only; never set a domain on the current central session cookie.
SSO_LEGACY_COOKIE_DOMAIN=

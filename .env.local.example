# ---- lgu-ecosystem:start ----
# LGU Ecosystem — See ../CLAUDE.md for the full ecosystem overview.
#
# Dev↔Prod parity rule: dev and prod configs MUST differ only in DNS
# hostnames, secrets, and APP_ENV/NODE_ENV/APP_DEBUG. If you find yourself
# diverging anything else between environments, stop and re-read the rule.
#
# Two SSO hosts, two purposes:
#   - Login redirect: sso-portal.local (dev) / sso-portal.lguquezon.local (prod)
#   - SSO API:        api.sso.local    (dev) / api.sso.lguquezon.local    (prod)
# Never sso-ui.*, never lgu-sso.test, never lgu-sso.local.
# ---- lgu-ecosystem:end ----

# LGU-SSO Admin UI Environment Configuration
#
# Copy this file to .env.local and adjust the values for your environment.

# ============================================
# API Configuration
# ============================================

# Set to "true" to use mock API during development
# Set to "false" (or remove) to use the real LGU-SSO backend
NEXT_PUBLIC_USE_MOCK_API=true

# Base URL for the LGU-SSO API (server-to-server calls from this portal)
# Only used when NEXT_PUBLIC_USE_MOCK_API is false.
# TODO: code today still reads NEXT_PUBLIC_API_BASE_URL — rename is tracked
#       under root CLAUDE.md Open Issue #2 (purge legacy hostnames). Until
#       the code is updated, set BOTH variables to the same value.
NEXT_PUBLIC_SSO_API_URL=http://api.sso.local/api/v1
# Prod: NEXT_PUBLIC_SSO_API_URL=https://api.sso.lguquezon.local/api/v1

# Legacy variable name — kept until code migration (see TODO above).
NEXT_PUBLIC_API_BASE_URL=http://api.sso.local/api/v1
# Prod: NEXT_PUBLIC_API_BASE_URL=https://api.sso.lguquezon.local/api/v1

# Self-reference: the public URL this portal is served at. Used when the
# portal needs to build a return-to URL or a callback.
NEXT_PUBLIC_SSO_PORTAL_URL=http://sso-portal.local
# Prod: NEXT_PUBLIC_SSO_PORTAL_URL=https://sso-portal.lguquezon.local
